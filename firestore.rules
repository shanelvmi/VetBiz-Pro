rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========== 🔒 Helper Functions ==========
    function isAuthenticated() {
      return request.auth != null;
    }
    // Deliberately does NOT check deactivation status here - that was
    // tried (checking status inside these two functions specifically),
    // but they're called on nearly every rule in this whole file, so
    // the extra lookup added real, noticeable delay across every
    // listener the app opens on login. Reverted in favor of a fast
    // client-side check instead: UserRoleProvider watches the current
    // user's own status in real time and force-signs-out within a
    // second or two of being deactivated. That's a deliberate,
    // accepted tradeoff - near-instant rather than rules-level-
    // absolute, in exchange for login and every other operation
    // staying fast. See UserRoleProvider.listenToCurrentUser().
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isInFacility(facilityId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityIds.hasAny([facilityId]);
    }
    function sharesAFacilityWith(userId) {
      let myFacilityIds = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('facilityIds', []);
      let theirFacilityIds = get(/databases/$(database)/documents/users/$(userId)).data.get('facilityIds', []);
      return myFacilityIds.hasAny(theirFacilityIds);
    }

    // True if the requester CREATED this facility - i.e. is its owner.
    function isFacilityCreator(facilityId) {
      return exists(/databases/$(database)/documents/facilities/$(facilityId)) &&
        get(/databases/$(database)/documents/facilities/$(facilityId)).data.createdBy == request.auth.uid;
    }

    // Whether the requester owns one of the first two facilities in a list.
    // Rules can't loop over a list, so this looks at a fixed number; a
    // Co-admin is in one facility, and every lookup counts towards the limit
    // on document reads a single rule evaluation may make, so it stops at two.
    function ownsAFacilityOf(facilityIds) {
      return (facilityIds.size() > 0 && isFacilityCreator(facilityIds[0])) ||
        (facilityIds.size() > 1 && isFacilityCreator(facilityIds[1]));
    }
    function isTogglingAssistantStatus() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['status', 'statusChangedBy', 'statusChangedByRole', 'statusChangedAt']) &&
        request.resource.data.status in ['active', 'deactivated'];
    }
    // What a person may change about THEMSELVES. Role, status and the lists of
    // facilities they belong to are deliberately absent: those are set by the
    // server, and isInFacility() trusts the list.
    function isEditingOwnProfileOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['fullName', 'phone', 'avatarUrl', 'lastActiveAt', 'defaultFacilityId']);
    }

    // The ordinary settings an Admin may change on their own facility.
    // Billing (subscriptionPlan, subscriptionExpiresAt, trialExpiresAt,
    // lastPaymentAt, lastPaymentAmount, lastManualOverrideBy) and ownership
    // (createdBy, createdAt, code) are NOT here: the Platform Admin and the
    // server own those.
    function isEditingFacilitySettingsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'type', 'address', 'phone', 'email', 'description', 'licenseNo',
        'ownership', 'tagline', 'tin', 'restockFrequency', 'status', 'updatedAt',
        'logoUrl', 'activityLogRetentionDays', 'debtOverdueDays',
        'allowAnytime', 'businessHours',
        'weekdayClosed', 'weekdayClosingTime',
        'saturdayClosed', 'saturdayClosingTime',
        'sundayClosed', 'sundayClosingTime'
      ]);
    }

    function isPlatformAdmin() {
      return exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }
    // Must match kGracePeriodDays in lib/constants/subscription_plans.dart.
    // No subscriptionExpiresAt set at all means this facility has never
    // had a subscription cycle yet (new signup, or rolled out before this
    // existed) - treated as an open trial, never locked, so this never
    // silently locks out a facility the moment it ships.
    function isSubscriptionLocked(facilityId) {
      let expiresAt = get(/databases/$(database)/documents/facilities/$(facilityId))
        .data.get('subscriptionExpiresAt', null);
      return expiresAt != null && request.time > expiresAt + duration.value(3, 'd');
    }
    // True only if the fields being changed are stock/batch-related -
    // lets an assistant adjust quantity/expiry/batch info on a product
    // (via Add Batch, Adjust Quantity, Move to Sellable) without opening
    // the door to changing its price or category, which stays admin-only.
    function isOnlyChangingStockFields() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['stockQty', 'sellableQty', 'expiry', 'batchNo', 'updatedAt']);
    }
    function isOnlyMarkingNotificationRead() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['readAt']);
    }
    // Deactivating your own account is fine (voluntary, reduces your
    // own access) - reactivating yourself or changing your own role is
    // not (that's an admin decision, not a self-service one). Only
    // allowed when 'status' is the only thing changing and the new
    // value is specifically 'deactivated'.
    function isSelfDeactivatingOnly() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status == 'deactivated';
    }
    // A Platform Admin's account can never be deactivated by anyone -
    // not themselves, not a facility admin, not even another Platform
    // Admin by mistake. Checked directly against the target account
    // (userId), not the requester, so it applies no matter who's
    // attempting the write.
    function isTryingToDeactivatePlatformAdmin(userId) {
      return exists(/databases/$(database)/documents/platform_admins/$(userId)) &&
        request.resource.data.get('status', 'active') == 'deactivated';
    }
    // ========== 👤 Users Collection ==========
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isPlatformAdmin());

      // A profile is NEVER created from the app. The server creates it -
      // registerOwner for an owner, joinWithInvite for an assistant - and
      // decides the role, the status and the facilities itself. While the app
      // could write its own profile, anyone could create theirs as an active
      // admin of any facility whose id they happened to know.
      allow create: if isAuthenticated() && isPlatformAdmin();

      allow update: if isAuthenticated() && !isTryingToDeactivatePlatformAdmin(userId) && (
        // Yourself: your own details (name, phone, photo...), or deactivating
        // your own account. NEVER your role, your status, or which facilities
        // you belong to - isInFacility() trusts that list, so letting people
        // edit it was letting them write themselves into any facility.
        (request.auth.uid == userId && (isEditingOwnProfileOnly() || isSelfDeactivatingOnly() || isPlatformAdmin())) ||
        (request.auth.uid != userId && isPlatformAdmin()) ||
        // An Admin can act on ASSISTANTS who share a facility - and only
        // assistants - and only to approve, deactivate or reactivate them.
        // Moving someone between facilities, or removing them from one, is
        // done by the server (reassignAssistant, removeAssistantFromFacility),
        // which checks you administer the facility.
        (request.auth.uid != userId && isAdmin() && sharesAFacilityWith(userId) &&
          resource.data.get('role', '') == 'assistant' &&
          isTogglingAssistantStatus()) ||

        // ...and the facility's OWNER can deactivate or reactivate a CO-ADMIN (an
        // Admin whose previous role was Assistant): the emergency brake. Status
        // fields only - a role is still only the Platform Admin's to change - and
        // only in a facility the owner created. A Co-admin can't do this to the
        // owner or to another Co-admin.
        (request.auth.uid != userId && isAdmin() && sharesAFacilityWith(userId) &&
          resource.data.get('role', '') == 'admin' &&
          resource.data.get('previousRole', '') == 'assistant' &&
          ownsAFacilityOf(resource.data.get('facilityIds', [])) &&
          isTogglingAssistantStatus())
      );
      // A person can delete their OWN record (Settings > Manage Account >
      // Delete Account), and a Platform Admin can delete any. A facility's
      // Admin cannot delete other people's records from the app: removing
      // someone goes through the removeAssistant Cloud Function, which is
      // not subject to these rules.
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isPlatformAdmin());
    }
    // ========== 🏢 Facilities Collection ==========
    match /facilities/{facilityId} {
      // Was previously fully public (no authentication required at
      // all). The one genuine reason for that - showing a facility's name
      // during invite-code registration, before the person has an account -
      // is now answered by the checkInviteCode function, which returns only
      // the name and type. Everyone else reading a facility needs to
      // actually belong to it, or be a Platform Admin.
      //
      // ...and the person who CREATED the facility. Without this, a LIST
      // query like "facilities where createdBy == me" (Manage Assistants,
      // Manage Account) is refused outright: Firestore only allows a query
      // if the rule can be proven true for every document it could return,
      // and "is a member of this facility" can't be proven from a
      // createdBy filter. "I created it" can - the query itself says so.
      allow read: if isAuthenticated() &&
        (isInFacility(facilityId) || isPlatformAdmin() || resource.data.createdBy == request.auth.uid);
      // Facilities are created by the server (registerOwner, addFacility),
      // which enforces the facility limit and sets the trial itself.
      allow create: if isAuthenticated() && isPlatformAdmin();
      // An Admin OF THIS FACILITY may change its ordinary settings. The
      // billing and ownership fields (the subscription and trial dates, who
      // created it, its code) are the Platform Admin's. This used to be "any
      // Admin, any facility, any field" - and anyone can register as an Admin -
      // so anyone could extend their own subscription, or change someone
      // else's facility.
      allow update: if isAuthenticated() &&
        (isPlatformAdmin() || (isAdmin() && isInFacility(facilityId) && isEditingFacilitySettingsOnly()));
      allow delete: if isAuthenticated() && isPlatformAdmin();
      // ========== 📦 Products ==========
      match /products/{productId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow create: if isAuthenticated() && isInFacility(facilityId);
        allow update: if isAuthenticated() && isInFacility(facilityId) && (isAdmin() || isOnlyChangingStockFields());
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
        match /batches/{batchId} {
          allow read, write: if isAuthenticated() && isInFacility(facilityId);
        }
      }
      // ========== 💵 Sales ==========
      match /sales/{saleId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow update: if isAuthenticated() && isInFacility(facilityId);
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
        // New sales are blocked once locked - existing sales can still be
        // paid down or edited (collecting money you're owed shouldn't
        // stop just because your own subscription lapsed).
        allow create: if isAuthenticated() && isInFacility(facilityId) && !isSubscriptionLocked(facilityId);
      }
      // ========== 🛠️ Services ==========
      match /services/{serviceId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow update: if isAuthenticated() && isInFacility(facilityId);
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
        allow create: if isAuthenticated() && isInFacility(facilityId) && !isSubscriptionLocked(facilityId);
      }
      // ========== 🛠️ Transactions ==========
      match /transactions/{transactionId} {
        allow read, create, update: if isAuthenticated() && isInFacility(facilityId);
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      // ========== 👥 Clients ==========
      match /clients/{clientId} {
        allow read, create, update: if isAuthenticated() && isInFacility(facilityId);
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      // ========== 💰 Debts ==========
      match /debts/{debtId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId);
      }
      // ========== 🗄️ Archived Sales (read-only for clients) ==========
      match /archived_sales/{saleId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false; // only written by Cloud Functions (Admin SDK)
      }
      match /archived_services/{serviceId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false; // only written by Cloud Functions (Admin SDK)
      }
      // ========== 📊 Daily Sales Summaries (read-only for clients) ==========
      match /dailySummaries/{summaryId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false; // only written by Cloud Functions (Admin SDK)
      }
      // Daily balance snapshots (product value, outstanding debt,
      // client count) - written only by recordDailySnapshots
      // (functions/index.js), read by facility members for the
      // dashboard's trend indicators.
      match /dailySnapshots/{dayId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false;
      }
      // Daily per-product sellable-stock snapshots - written by the
      // same recordDailySnapshots function, read by the Reports
      // feature for each product's authoritative "opening" figure.
      match /dailyStockSnapshots/{dayId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false;
      }
      match /dailyCollections/{dayId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false;
      }
      match /dailyServiceSummaries/{dayId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false;
      }
      match /dailyTransactionSummaries/{dayId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow write: if false;
      }
      // Daily closing reports - generated by whichever facility member
      // taps "Generate Today's Report" (not admin-only, since this is
      // the assistant's own end-of-day record). A draft report can be
      // updated once, to submit the physical stock/cash counts and
      // flip status to 'submitted' - checked against the *existing*
      // document's own status, so once it's submitted this condition
      // can never be true again for that document, for anyone,
      // including admin. Delete is admin-only and draft-only - a
      // submitted report can never be deleted by anyone.
      match /dailyReports/{reportId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow create: if isAuthenticated() && isInFacility(facilityId);
        allow update: if isAuthenticated() && isInFacility(facilityId) && resource.data.status == 'draft';
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin() && resource.data.status == 'draft';
      }
      match /trash_products/{productId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      match /trash_clients/{clientId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      match /trash_services/{serviceId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      match /trash_sales/{saleId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      match /trash_transactions/{transactionId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow create: if isAuthenticated() && isPlatformAdmin();
        allow update: if isAuthenticated() && isInFacility(facilityId) && isOnlyMarkingNotificationRead();
        allow delete: if false;
      }
      match /payment_submissions/{submissionId} {
        allow read: if isAuthenticated() && (isInFacility(facilityId) || isPlatformAdmin());
        allow create: if isAuthenticated() && isInFacility(facilityId);
        allow update: if isAuthenticated() && isPlatformAdmin();
        allow delete: if false;
      }
      // ========== 💵 Payments ==========
      match /payments/{paymentId} {
        allow read: if isAuthenticated() && isInFacility(facilityId);
        allow create: if isAuthenticated() && isInFacility(facilityId)
          && (request.resource.data.clientId is string || request.resource.data.clientId == null)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.timestamp is timestamp
          && request.resource.data.paidById == request.auth.uid;
        // An Admin of THIS facility - or a Platform Admin. This used to be
        // "any Admin", so an Admin of one business could edit or delete
        // another business's payment records.
        allow update, delete: if isAuthenticated() &&
          (isPlatformAdmin() || (isInFacility(facilityId) && isAdmin()));
      }
      match /counters/{counterId} {
        allow read, write: if isAuthenticated() && isInFacility(facilityId);
      }
      // Stock-addition log - one entry per addBatch() call, recording
      // exactly how much sellable/stock quantity was added that call
      // (a new batch or a merge into an existing one both log here the
      // same way). Read by the Reports feature to compute "Added"
      // reliably; an immutable log, so no update or delete path -
      // same principle as activity_logs.
      match /stockAdditions/{additionId} {
        allow read, create: if isAuthenticated() && isInFacility(facilityId);
        allow update, delete: if false;
      }
      // ========== 📦 Stock Adjustments (Nested) ==========
      // Logged whenever a product's stock quantity is directly edited
      // (not a sale, not a restock) - who changed it, and what it went
      // from/to. Read by the Reports feature to explain the "Adjusted"
      // figure in Product Movement; an immutable log, same principle
      // as stockAdditions and activity_logs above.
      match /stock_adjustments/{adjustmentId} {
        allow read, create: if isAuthenticated() && isInFacility(facilityId);
        allow update, delete: if false;
      }
      // ========== 📝 Activity Logs (Nested) ==========
      match /activity_logs/{logId} {
        // Any authenticated user can create logs
        allow create: if isAuthenticated();
        // Who can read an entry. An ADMIN of the facility (the owner, or a
        // Co-admin) reads all of them. An ASSISTANT reads only the entries
        // that are THEIRS: ones they did (userId), or that are ABOUT them
        // (targetUserId - "approved", "promoted", and so on).
        //
        // This used to be "any member reads everything", so an assistant saw
        // every admin matter in the facility - who was rejected, who was
        // deactivated - and, since this is the rule rather than just the
        // screen, could read it straight from the database too.
        //
        // The app's queries for an assistant filter on userId / targetUserId,
        // which is what lets this be checked for a LIST: a query that doesn't
        // is refused outright (see firestore_rules_tests).
        allow read: if isAuthenticated() && isInFacility(facilityId) &&
          (isAdmin() ||
           resource.data.userId == request.auth.uid ||
           resource.data.targetUserId == request.auth.uid);
        // Logs can't be edited...
        allow update: if false;
        // ...but an admin of this facility can delete them. That is how the
        // "Keep logs for N days" setting actually removes expired logs
        // (ActivityLogRetention.deleteExpired). Without this the delete is
        // refused, the cleanup can never remove anything, and old logs pile
        // up forever. Do not tighten this back to `if false` without also
        // removing the retention feature.
        allow delete: if isAuthenticated() && isInFacility(facilityId) && isAdmin();
      }
    }
    // ========== 🌐 Collection-group access for platform admin subscription review ==========
    match /{path=**}/payment_submissions/{submissionId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
    }
    // ========== 👑 Platform Admins ==========
    match /platform_admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isPlatformAdmin());
      allow write: if isAuthenticated() && isPlatformAdmin();
    }
    // ========== 📢 Public Announcements ==========
    match /public_announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    // Login screen poster - readable by anyone (including the login
    // screen itself, before anyone is authenticated), writable only by
    // a Platform Admin via the Announcements tab.
    match /app_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isPlatformAdmin();
    }
    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && isPlatformAdmin();
    }
    match /promotions/{promoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isPlatformAdmin();
    }
    match /inviteCodes/{code} {
      // Nothing in the app reads or writes an invite code directly any more
      // except an Admin looking at, or revoking, their OWN facility's. Checking
      // a code (checkInviteCode), creating one (createInviteCode) and using
      // one up (joinWithInvite) are done by the server.
      //
      // This used to be readable by EVERYONE, signed in or not - and listable.
      // Each document carries a facility's id, name and type, so that handed
      // every business's id to anyone who asked.
      allow get: if isAuthenticated() &&
        (isPlatformAdmin() || (isAdmin() && isInFacility(resource.data.facilityId)));
      // The app's two queries both filter by facilityId, which is what lets
      // this be checked against the query itself.
      allow list: if isAuthenticated() &&
        (isPlatformAdmin() || (isAdmin() && isInFacility(resource.data.facilityId)));
      allow create, update: if isAuthenticated() && isPlatformAdmin();
      allow delete: if isAuthenticated() &&
        (isPlatformAdmin() || (isAdmin() && isInFacility(resource.data.facilityId)));
    }
  }
}
